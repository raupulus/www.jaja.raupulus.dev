APP_NAME="JaJa Project"
APP_DESCRIPTION="La mejor comunidad para entretenimiento y compartir el humor"
APP_AUTHOR="Raúl Caro Pastorino"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://jaja.raupulus.dev

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=jaja_raupulus
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=465
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

## Google Recaptcha
GOOGLE_CAPTCHA_KEY=
GOOGLE_CAPTCHA_SECRET=

# Lista de IPs excluidas del rate limit (separadas por comas)
RATE_LIMIT_EXCLUDED_IPS=127.0.0.1,::1

## Servicio externo de publicación en redes sociales
SOCIAL_PUBLISHER_URL=http://localhost:8080/publish
SOCIAL_PUBLISHER_CONNECT_TIMEOUT=5
SOCIAL_PUBLISHER_TIMEOUT=15

## Tokens Sanctum (vacío = sin caducidad automática por compatibilidad con bots)
SANCTUM_TOKEN_EXPIRATION=

## Proxies confiables (IPs/CIDRs de Apache/Cloudflare separados por comas)
TRUSTED_PROXIES=

## Grupos excluidos de listados públicos y redes sociales (IDs separados por comas)
CONTENT_EXCLUDED_PUBLIC_GROUP_IDS=4,14
